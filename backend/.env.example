NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5178

# Azure (configuration, not secrets)
AZURE_SUBSCRIPTION_ID=<your-subscription-id>
AZURE_RESOURCE_GROUP=rg-aibridge-dev
KEY_VAULT_URL=https://<your-key-vault-name>.vault.azure.net/
AZURE_OPENAI_ENDPOINT=https://<your-foundry-resource>.openai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=<your-embedding-deployment-name>

# PostgreSQL + pgvector (Phase 9)
PG_HOST=<your-server>.postgres.database.azure.com
PG_PORT=5432
PG_USER=<admin-user>
PG_PASSWORD=<admin-password>
PG_DB=aibridge
PG_SSL=true
